class AddDiaryPage extends StatefulWidget {
  // ถ้า null = เพิ่ม
  // ถ้ามีค่า = แก้ไข
  final Diary? existing;

  const AddDiaryPage({super.key, this.existing});

  @override
  State<AddDiaryPage> createState() => _AddDiaryPageState();
}

class _AddDiaryPageState extends State<AddDiaryPage> {
  final _formKey = GlobalKey<FormState>();

  final TextEditingController _titleController = TextEditingController();

  final TextEditingController _contentController = TextEditingController();

  bool _isImportant = false;

  bool _isPinned = false;

  String _type = 'ส่วนตัว';

  String _selectedMood = 'มีความสุข';

  final List<String> _moods = [
    'มีความสุข',
    'เฉยๆ',
    'เศร้า',
    'เหนื่อย',
    'ตื่นเต้น',
  ];

  // วันที่เริ่มต้น = วันนี้
  DateTime _selectedDate = DateTime.now();

  @override
  void initState() {
    super.initState();

    // =================================================
    // ถ้าเป็นโหมดแก้ไข ให้เอาข้อมูลเดิมมาใส่
    // =================================================

    if (widget.existing != null) {
      final diary = widget.existing!;

      _titleController.text = diary.title;

      _contentController.text = diary.content;

      _selectedMood = diary.mood;

      _selectedDate = DateTime.parse(diary.date);

      _isImportant = diary.isImportant;

      _isPinned = diary.isPinned;

      _type = diary.type;
    }
  }

  @override
  void dispose() {
    _titleController.dispose();

    _contentController.dispose();

    super.dispose();
  }

  // ===================================================
  // เลือกวันที่
  // ===================================================

  Future<void> _selectDate() async {
    final DateTime? picked = await showDatePicker(
      context: context,

      initialDate: _selectedDate,

      firstDate: DateTime(2000),

      lastDate: DateTime(2100),
    );

    if (picked != null) {
      setState(() {
        _selectedDate = picked;
      });
    }
  }

  // ===================================================
  // SAVE
  // ===================================================

  void _saveDiary() {
    if (!_formKey.currentState!.validate()) {
      return;
    }

    final diary = Diary(
      // ถ้าแก้ไข ให้ใช้ id เดิม
      id: widget.existing?.id,

      title: _titleController.text.trim(),

      content: _contentController.text.trim(),

      quote: widget.existing?.quote ?? '',

      date: _selectedDate.toString().substring(0, 10),

      // ตอนนี้ยังเริ่มที่ 0
      point: widget.existing?.point ?? '0',

      mood: _selectedMood,

      isImportant: _isImportant,

      isPinned: _isPinned,

      type: _type,
    );

    Navigator.pop(context, diary);
  }

  @override
  Widget build(BuildContext context) {
    final bool isEdit = widget.existing != null;

    return Scaffold(
      // =================================================
      // APP BAR
      // =================================================
      appBar: AppBar(title: Text(isEdit ? 'แก้ไขบันทึก' : 'เพิ่มบันทึกหนัง')),

      // =================================================
      // BODY
      // =================================================
      body: SingleChildScrollView(
        child: Padding(
          padding: const EdgeInsets.all(16),

          child: Form(
            key: _formKey,

            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,

              children: [
                // ========================================
                // TITLE
                // ========================================
                TextFormField(
                  controller: _titleController,

                  decoration: const InputDecoration(
                    labelText: 'ชื่อหนัง',

                    border: OutlineInputBorder(),

                    prefixIcon: Icon(Icons.movie),
                  ),

                  validator: (value) {
                    if (value == null || value.trim().isEmpty) {
                      return 'กรุณากรอกชื่อหนัง';
                    }

                    return null;
                  },
                ),

                const SizedBox(height: 16),

                // ========================================
                // CONTENT
                // ========================================
                TextFormField(
                  controller: _contentController,

                  maxLines: 5,

                  decoration: const InputDecoration(
                    labelText: 'รายละเอียด',

                    border: OutlineInputBorder(),

                    prefixIcon: Icon(Icons.notes),

                    alignLabelWithHint: true,
                  ),

                  validator: (value) {
                    if (value == null || value.trim().isEmpty) {
                      return 'กรุณากรอกรายละเอียด';
                    }

                    return null;
                  },
                ),

                const SizedBox(height: 16),

                // ========================================
                // DATE
                // ========================================
                const Text(
                  'วันที่ดูหนัง',

                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                ),

                const SizedBox(height: 8),

                SizedBox(
                  width: double.infinity,

                  child: OutlinedButton.icon(
                    onPressed: _selectDate,

                    icon: const Icon(Icons.calendar_month),

                    label: Text(
                      '${_selectedDate.year}-'
                      '${_selectedDate.month.toString().padLeft(2, '0')}-'
                      '${_selectedDate.day.toString().padLeft(2, '0')}',
                    ),
                  ),
                ),

                const SizedBox(height: 16),

                // ========================================
                // MOOD
                // ========================================
                DropdownButtonFormField<String>(
                  initialValue: _selectedMood,

                  decoration: const InputDecoration(
                    labelText: 'อารมณ์วันนี้',

                    border: OutlineInputBorder(),
                  ),

                  items: _moods.map((mood) {
                    return DropdownMenuItem<String>(
                      value: mood,

                      child: Text(mood),
                    );
                  }).toList(),

                  onChanged: (value) {
                    if (value != null) {
                      setState(() {
                        _selectedMood = value;
                      });
                    }
                  },
                ),

                const SizedBox(height: 10),

                // ========================================
                // IMPORTANT
                // ========================================
                CheckboxListTile(
                  contentPadding: EdgeInsets.zero,

                  title: const Text('บันทึกสำคัญ'),

                  value: _isImportant,

                  onChanged: (value) {
                    setState(() {
                      _isImportant = value ?? false;
                    });
                  },
                ),

                // ========================================
                // PINNED
                // ========================================
                SwitchListTile(
                  contentPadding: EdgeInsets.zero,

                  title: const Text('ปักหมุด'),

                  value: _isPinned,

                  onChanged: (value) {
                    setState(() {
                      _isPinned = value;
                    });
                  },
                ),

                const SizedBox(height: 10),

                // ========================================
                // TYPE
                // ========================================
                const Text(
                  'ประเภท',

                  style: TextStyle(fontSize: 16, fontWeight: FontWeight.bold),
                ),

                RadioListTile<String>(
                  contentPadding: EdgeInsets.zero,

                  title: const Text('ส่วนตัว'),

                  value: 'ส่วนตัว',

                  groupValue: _type,

                  onChanged: (value) {
                    setState(() {
                      _type = value!;
                    });
                  },
                ),

                RadioListTile<String>(
                  contentPadding: EdgeInsets.zero,

                  title: const Text('งาน'),

                  value: 'งาน',

                  groupValue: _type,

                  onChanged: (value) {
                    setState(() {
                      _type = value!;
                    });
                  },
                ),

                const SizedBox(height: 20),

                // ========================================
                // SAVE BUTTON
                // ========================================
                SizedBox(
                  width: double.infinity,

                  height: 50,

